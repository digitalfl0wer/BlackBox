# Required for OpenAI transcription mode
OPENAI_API_KEY=

# Server config
MCP_HOST=127.0.0.1
MCP_PORT=3333

# Where transcripts are written
TRANSCRIPT_OUTPUT_DIR=./transcripts

# openai | local
TRANSCRIBER_MODE=openai

# OpenAI model options include: whisper-1, gpt-4o-mini-transcribe, gpt-4o-transcribe
TRANSCRIPTION_MODEL=whisper-1

# Optional for local whisper mode (path to whisper binary)
WHISPER_BIN=whisper

# Optional for local whisper mode
WHISPER_MODEL_PATH=
